# Copy this file to .env and fill in your real ThetaData Cloudflare Access
# credentials. .env is gitignored -- never commit real credentials.
# Shared with your partner: same values as the Monte-Carlo-American-Pricer-Greeks
# project's .env, since both go through the same api.potatohedge.com proxy.
THETADATA_CF_ACCESS_CLIENT_ID=your_client_id_here.access
THETADATA_CF_ACCESS_CLIENT_SECRET=your_client_secret_here
