    {"type": "text", "id": "t_foot", "x": 50, "y": 685, "width": 740, "height": 250, "text": "Also in repo (not all drawn):\nadapters, option_chains, orchestrator_output,\noutputs, scripts, system, tests, migrations,\n_broker_control, sqlite-tools, rh_exports\n\nGit: FinancialDevelopment (this tree)\nVault git: bottlefedchaney808/obsidian-brain\nClone: C:/Users/bottl/obsidian-vault", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r_foot", "originalText": "Also in repo (not all drawn):\nadapters, option_chains, orchestrator_output,\noutputs, scripts, system, tests, migrations,\n_broker_control, sqlite-tools, rh_exports\n\nGit: FinancialDevelopment (this tree)\nVault git: bottlefedchaney808/obsidian-brain\nClone: C:/Users/bottl/obsidian-vault", "autoResize": true},

    {"type": "rectangle", "id": "v_foot", "x": 880, "y": 700, "width": 870, "height": 250, "roundness": {"type": 3}, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#f59e0b", "boundElements": [{"id": "t_vfoot", "type": "text"}]},
    {"type": "text", "id": "t_vfoot", "x": 890, "y": 715, "width": 850, "height": 220, "text": "Vault rule: a note belongs to one leg.\nIf it touches two, primary leg + [[wikilink]]. Never duplicate.\n\nAlso: Home/Lawn Repair Plan, Attachments/, Templates/\nTrading research stays descriptive. Software that prices jobs\nlives under Development, not Construction.", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "v_foot", "originalText": "Vault rule: a note belongs to one leg.\nIf it touches two, primary leg + [[wikilink]]. Never duplicate.\n\nAlso: Home/Lawn Repair Plan, Attachments/, Templates/\nTrading research stays descriptive. Software that prices jobs\nlives under Development, not Construction.", "autoResize": true}
