# --------------------------------------------------------------------------
# Dockerfile.dashboard -- FastAPI web interface over the swaps DB + orchestrator
#
# Serves dashboard/app.py (FastAPI app object `app`) via uvicorn. Reads/writes
# the same swaps.db as the scheduler service through a shared named volume.
# --------------------------------------------------------------------------
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

VOLUME ["/app/data"]
ENV SWAPS_DB_PATH=/app/data/swaps.db
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

# dashboard/app.py exposes GET /health -> {"ok": true, ...}. curl -f treats
# any non-2xx as unhealthy.
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["python", "-m", "uvicorn", "dashboard.app:app", "--host", "0.0.0.0", "--port", "8000"]
