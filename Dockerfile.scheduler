# --------------------------------------------------------------------------
# Dockerfile.scheduler -- DTCC swaps polling background service
#
# Runs scheduled_ingest.py in scheduler mode: polls DTCC's live slice feed on
# an interval (POLL_INTERVAL_MINUTES, default 5) and decodes new UPIs after
# each pass. Exits cleanly on SIGTERM (shutdown_signal.py) so `docker stop`
# and compose down drain in-flight work instead of killing it.
# --------------------------------------------------------------------------
FROM python:3.12-slim

# build-essential: some pinned scientific deps (e.g. arch, scipy) can fall
# back to source builds on manylinux wheel gaps.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# swaps.db lives on a named volume shared with the dashboard service (see
# docker-compose.yml) so ingested data survives container recreation.
VOLUME ["/app/data"]
ENV SWAPS_DB_PATH=/app/data/swaps.db
ENV SCHEDULER_HEARTBEAT_FILE=/app/data/.scheduler_heartbeat
ENV PYTHONUNBUFFERED=1

# scheduled_ingest.py touches SCHEDULER_HEARTBEAT_FILE every 60s (a dedicated
# APScheduler job, independent of POLL_INTERVAL_MINUTES) as soon as the
# scheduler starts. No HTTP surface exists on this service, so health is
# checked by freshness of that file rather than an endpoint. start-period
# covers pip/apt already having run at build time, not runtime, so it only
# needs to cover process startup.
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "\
import os, sys, time; \
p = os.environ.get('SCHEDULER_HEARTBEAT_FILE', '/app/data/.scheduler_heartbeat'); \
sys.exit(0 if os.path.exists(p) and time.time() - os.path.getmtime(p) < 150 else 1)"

# NOTE: bare `python scheduled_ingest.py` (no flags) just prints --help and
# exits 0 -- it does not start the background poller. --start-scheduler is
# required to actually run the service described by this Dockerfile.
CMD ["python", "scheduled_ingest.py", "--start-scheduler"]
