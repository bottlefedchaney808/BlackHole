# swaps.db is the GitHub-sized recent-window primary (effective_date >= 2026-01-01).
# Live queries point at OneDrive/Stocks/Swaps/swaps.db via SWAPS_DB_PATH.
# Keep volatile WAL/SHM/lock sidecars ignored so they never get staged.
swaps.db
swaps.db-shm
swaps.db-wal
swaps.db.lock

# Module-registry automatic archiving system (Phase 6 of the Modularization
# Overhaul) -- shared/module_archive.py's dedicated SQLite DB, deliberately
# separate from swaps.db (see that module's docstring). Same WAL sidecar
# pattern as swaps.db above.
module_archive.db
module_archive.db-shm
module_archive.db-wal
