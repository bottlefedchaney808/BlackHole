# Core Market Data API
# ThetaData API credentials (required for options pricing & historical data)
# THETADATA_CF_ACCESS_CLIENT_ID=your_client_id_here
# THETADATA_CF_ACCESS_CLIENT_SECRET=your_client_secret_here

# Dashboard Security (Phase 1 Fix)
# API key for dashboard POST endpoints. Change this in production!
# Default: dev-key-change-in-production (for development only)
# DASHBOARD_API_KEY=your-secure-api-key-here

# SQLite Configuration
# Database file path (defaults to ./swaps.db)
# SWAPS_DB_PATH=./swaps.db

# Logging & Debug
# Set to DEBUG for verbose logging
# LOG_LEVEL=INFO
